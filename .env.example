VITE_API_BASE_URL=http://localhost:3001/api
API_PORT=3001
UPLOAD_DIR=uploads
AUTH_SECRET=
ADMIN_INVITE_CODE=

# 以上密钥和以下种子密码由 npm run auth:init 在本机随机生成，请勿提交实际值。
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# Python 环境选择（用于 YOLO 图片识别，可选；不配置则图片识别降级，网站仍可启动）。
# 系统不再自动探测，必须由你在下面手动指定一种环境：
#   方式一：.venv 虚拟环境 —— 填写环境目录（支持绝对路径或相对项目根目录的路径）
#     PYTHON_ENV_PATH=.venv
#   方式二：全局 Python —— 填写解释器路径，或填 PATH 中的命令名
#     PYTHON_EXEC=python
#   方式三：Conda 环境 —— 填写该环境内 python.exe 的绝对路径
#     PYTHON_EXEC=C:\\Users\\<用户名>\\miniconda3\\envs\\<环境名>\\python.exe
# 说明：PYTHON_ENV_PATH 填目录，会自动定位其中的 Scripts/python.exe（Windows）或 bin/python（Linux/macOS）；
#       PYTHON_EXEC 直接填解释器文件路径，最精确，适合任意环境。
# PYTHON_EXEC=python
# PYTHON_ENV_PATH=.venv

# 可选：相对路径均以 apps/api 为基准，通常无需修改。
# 当前生效模型为玉米 11 类病害检测模型 corn_disease_best.pt（默认路径）。
# YOLO_MODEL_PATH=models/corn_disease_best.pt
# YOLO_SCRIPT_PATH=scripts/yolo_inference.py
# YOLO_CONFIG_DIR=.ultralytics

# ==============================================================================
# 大语言模型配置（兼容国内各大主流模型 OpenAI 标准接口）
# ==============================================================================

# 默认使用哪个模型；管理员可在知识库页面切换，选择会保存到 apps/api/data/llm-provider.json
LLM_PROVIDER=deepseek

# DeepSeek API（密钥仅存放在后端 .env，不会返回给浏览器）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本地 Ollama（先运行 ollama pull qwen2.5:7b；无需 API Key）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 兼容旧配置：LLM_API_KEY、LLM_BASE_URL、LLM_MODEL 仍可作为 DeepSeek 配置回退使用。
