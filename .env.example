VITE_API_BASE_URL=http://localhost:3001/api
API_PORT=3001
UPLOAD_DIR=uploads
AUTH_SECRET=
ADMIN_INVITE_CODE=admin888

# 首次初始化演示账号所用密码，可在初始化前修改。
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_PASSWORD=User@123456

# Python 环境选择（用于 YOLO 图片识别，可选；不配置则图片识别降级，网站仍可启动）。
# 系统不再自动探测，必须由你在下面手动指定一种环境：
#   方式一：.venv 虚拟环境 —— 填写环境目录（支持绝对路径或相对项目根目录的路径）
#     PYTHON_ENV_PATH=.venv
#   方式二：全局 Python —— 填写解释器路径，或填 PATH 中的命令名
#     PYTHON_EXEC=python
#   方式三：Conda 环境 —— 填写该环境内 python.exe 的绝对路径
#     PYTHON_EXEC=C:\\Users\\<用户名>\\miniconda3\\envs\\<环境名>\\python.exe
# 说明：PYTHON_ENV_PATH 填目录，会自动定位其中的 Scripts/python.exe（Windows）或 bin/python（Linux/macOS）；
#       PYTHON_EXEC 直接填解释器文件路径，最精确，适合任意环境。
# PYTHON_EXEC=python
# PYTHON_ENV_PATH=.venv

# 可选：相对路径均以 apps/api 为基准，通常无需修改。
# 当前生效模型为玉米 11 类病害检测模型 corn_disease_best.pt（默认路径）。
# YOLO_MODEL_PATH=models/corn_disease_best.pt
# YOLO_SCRIPT_PATH=scripts/yolo_inference.py
# YOLO_CONFIG_DIR=.ultralytics

# ==============================================================================
# 大语言模型配置（兼容国内各大主流模型 OpenAI 标准接口）
# ==============================================================================

# 1. 通用 API Key（若为空则自动优雅降级为本地规则模式）
LLM_API_KEY=

# 2. 接口 Base URL 与模型名称（根据你的服务商解开对应注释即可）

# --- [选项 A] DeepSeek 官方 ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- [选项 B] 阿里百炼（通义千问 Qwen）---
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# --- [选项 C] 硅基流动 SiliconFlow（新用户免费送额度，支持 DeepSeek/Qwen）---
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# --- [选项 D] 智谱 AI (GLM) ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# --- [选项 E] 本地 Ollama 离线运行（无需 API Key）---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
