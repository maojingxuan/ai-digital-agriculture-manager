{
  "name": "@agri/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:seed:reset": "node prisma/seed.js --force",
    "test:models": "node prisma/model-test.js",
    "test:knowledge": "npm run build && node prisma/knowledge-test.js",
    "test:agent": "npm run build && node prisma/agent-test.js",
    "test:persistence": "npm run build && node prisma/persistence-test.js",
    "test:auth": "npm run build && node prisma/auth-test.js"
  },
  "dependencies": {
    "@agri/shared": "0.1.0",
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
